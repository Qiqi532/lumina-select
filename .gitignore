# ===========================================================================
# 光影选片助手 .gitignore —— MVP 仓库规则
# ===========================================================================

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
# PYTHONPYCACHEPREFIX 指向的字节码缓存目录
# 注意：gitignore 不支持行内注释，注释必须单独成行，否则整行会被当成一个永不命中的 pattern
pycache/

# ---- 虚拟环境 / 缓存（不落仓库）----
.venv/
.venv-cpu/
.venv-light/
.pip_cache/
.hf_cache/
.torch_cache/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# ---- 数据（测试图 / 索引库 / 上传目录）----
data/
# 例外：models 目录只提交小权重（LAION 美学头约 3KB），
#       大权重（CLIP / 闭眼 ViT / MediaPipe）首次运行自动下载到 .hf_cache
!models/
models/*
!models/sa_0_4_vit_b_32_linear.pth

# ---- 日志 / 运行期文件 ----
*.log
*.db
*.db-wal
*.db-shm
_srv.log
_srv_err.log

# ---- IDE / 系统 ----
.idea/
.vscode/
.superpowers/
*.swp
.DS_Store
Thumbs.db

# ---- exe 打包产物（用 build_dist.bat 重新生成）----
build/
build-cpu/
build_light/
build-tools/
dist/
dist-cpu/
dist_light/
Output/
Output_light/
release/exiftool/
release/exiftool-stage-*/
release/exiftool-13.59_64.zip
benchmark-*.json
*.spec
光影选片助手.exe
# 打包态崩溃日志（_install_crash_logger 写到 exe 旁）
crash.log

# 例外：自包含打包规格是构建必需文件，随仓库分发
!光影选片助手_dist.spec
!光影选片助手_dist_lightweight.spec
