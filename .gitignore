# ===========================================================================
# Lumina Select 本地开发与构建产物
# ===========================================================================

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
pycache/

# ---- 虚拟环境 / 缓存（不落仓库）----
.venv/
.venv-cpu/
.pip_cache/
.hf_cache/
model_snapshots/
.torch_cache/
.pytest_cache/
_pytest_*/
.mypy_cache/
.coverage
htmlcov/

# ---- 本地资料与数据（不提交）----
_archive/
data/
# 例外：models 目录只提交小权重（LAION 美学头约 3KB），
#       大权重（CLIP / 闭眼 ViT / MediaPipe）保存在本地缓存或锁定快照，不提交到仓库
!models/
models/*
!models/sa_0_4_vit_b_32_linear.pth

# ---- 日志 / 运行期文件 ----
*.log
*.db
*.db-wal
*.db-shm

# ---- IDE / 系统 ----
.idea/
.vscode/
.superpowers/
# 工作区临时目录（构建日志 / 一次性调试脚本），不进仓库
.workbuddy/
*.swp
.DS_Store
Thumbs.db

# ---- 打包产物（用 build_dist.bat 重新生成）----
build/
build-cpu/
build-tools/
dist/
dist-cpu/
Output/
release/exiftool/
release/exiftool-stage-*/
release/exiftool-13.59_64.zip
benchmark-*.json
*.spec
光影选片助手.exe
# 自包含打包规格是构建必需文件，随仓库分发
!光影选片助手_dist.spec
