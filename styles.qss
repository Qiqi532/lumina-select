/* Lumina Select v0.5; values rendered from ui/theme.py tokens. */
QWidget {
    background-color: #111315;
    color: #DFE2E6;
    font-family: "Segoe UI", "Microsoft YaHei UI", sans-serif;
    font-size: 13px;
}
QMainWindow, QDialog { background-color: #111315; }
QLabel { background: transparent; }
QFrame#WorkflowHeader, QFrame#Panel {
    background-color: #181B1E;
    border: 1px solid #303338;
    border-radius: 8px;
}
QLabel#PageTitle { font-size: 22px; font-weight: 700; }
QLabel#PageSub, QLabel#Muted { color: #9299A1; }
QLabel#StageState { color: #D7AA5A; font-weight: 600; }
QPushButton {
    background-color: #1C1F22;
    border: 1px solid #303338;
    border-radius: 7px;
    padding: 8px 16px;
    min-height: 24px;
}
QPushButton:hover { border-color: #DFE2E6; }
QPushButton:focus { border: 2px solid #D7AA5A; }
QPushButton:disabled { color: #9299A1; }
QPushButton#Primary {
    background-color: #D7AA5A;
    border-color: #D7AA5A;
    color: #111315;
    font-weight: 700;
}
QPushButton#Primary:hover { background-color: #DFB970; }
QPushButton#StageButton[state="current"] {
    border-color: #D7AA5A;
    color: #D7AA5A;
    font-weight: 700;
}
QPushButton#StageButton[state="done"] { color: #73C69A; }
QPushButton#Danger { color: #D46A6A; }
QProgressBar {
    background-color: #1C1F22;
    border: 1px solid #303338;
    border-radius: 6px;
    min-height: 20px;
    text-align: center;
}
QProgressBar::chunk { background-color: #D7AA5A; }
QLineEdit {
    background-color: #1C1F22;
    border: 1px solid #303338;
    border-radius: 6px;
    padding: 8px;
}
QLineEdit:focus { border: 2px solid #D7AA5A; }
QStatusBar { background-color: #181B1E; color: #9299A1; }
QFrame#ProjectCard {
    background-color: #1C1F22;
    border: 1px solid #303338;
    border-radius: 10px;
}
QFrame#ProjectCard:hover { border-color: #D7AA5A; }
QLabel#CardTitle { font-size: 15px; font-weight: 700; }
QLabel#CardMeta { color: #9299A1; }
QLabel#CardWarn { color: #DFB970; }
QPushButton#CardForget {
    background: transparent;
    border: 1px solid #303338;
    border-radius: 6px;
    padding: 1px 8px;
    color: #9299A1;
}
QPushButton#CardForget:hover { border-color: #D46A6A; color: #D46A6A; }
QScrollArea { background: transparent; }
/* ---- 【T-08】分面筛选条 ---- */
QWidget#FilterSidebar {
    background-color: #181B1E;
    border: 1px solid #303338;
    border-radius: 8px;
}
QLabel#SidebarTitle { font-size: 15px; font-weight: 700; }
QLabel#SectionTitle { color: #9299A1; font-size: 12px; font-weight: 600; }
QLabel#ScopeLabel { color: #D7AA5A; font-size: 12px; }
QFrame#Divider { color: #303338; max-height: 1px; }
QPushButton#LinkButton {
    background: transparent;
    border: none;
    padding: 2px 6px;
    min-height: 0;
    color: #9299A1;
    font-size: 12px;
}
QPushButton#LinkButton:hover { color: #D7AA5A; }
QPushButton#FacetHeader {
    background: transparent;
    border: none;
    padding: 2px 0;
    min-height: 0;
    text-align: left;
    color: #DFE2E6;
    font-weight: 600;
}
QPushButton#FacetHeader:hover { color: #D7AA5A; }
QPushButton#FacetChip {
    background-color: #1C1F22;
    border: 1px solid #303338;
    border-radius: 6px;
    padding: 3px 8px;
    min-height: 20px;
    font-size: 12px;
    text-align: left;
}
QPushButton#FacetChip:hover { border-color: #DFE2E6; }
QPushButton#FacetChip:checked {
    background-color: #D7AA5A;
    border-color: #D7AA5A;
    color: #111315;
    font-weight: 700;
}
QPushButton#FacetChip:disabled { color: #303338; }
/* ---- 【T-07】统一任务面板 ---- */
QWidget#TaskPanel {
    background-color: #181B1E;
    border: 1px solid #303338;
    border-radius: 8px;
}
QFrame#TaskRow {
    background-color: #1C1F22;
    border-radius: 6px;
}
QLabel#TaskRunning { color: #D7AA5A; font-weight: 700; }
QLabel#TaskOk { color: #73C69A; font-weight: 700; }
QLabel#TaskFail { color: #D46A6A; font-weight: 700; }
QLabel#TaskMuted { color: #9299A1; }
QPushButton#TaskCancel {
    background: transparent;
    border: 1px solid #303338;
    border-radius: 6px;
    padding: 2px 8px;
    min-height: 0;
    color: #9299A1;
    font-size: 12px;
}
QPushButton#TaskCancel:hover { border-color: #D46A6A; color: #D46A6A; }
QPushButton#TaskCancel:disabled { color: #303338; border-color: #303338; }
